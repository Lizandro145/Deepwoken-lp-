"""Registo e sessão (Requisito 3.1)."""
import sqlite3
from seguranca import ErroUtilizador, gerar_hash, verificar, validar


def _executar(con, sql, args):
    try:
        con.execute(sql, args)
        con.commit()
    except sqlite3.IntegrityError:
        raise ErroUtilizador("Esse username já existe (ou tipo inválido).")


def registar(con, username, email, password, tipo="Jogador"):
    validar(username, email, password)
    h, salt = gerar_hash(password)
    _executar(con, "INSERT INTO utilizadores (username,email,password_hash,salt,tipo) "
                   "VALUES (?,?,?,?,?)", (username, email, h, salt, tipo))


class Sessao:
    def __init__(self):
        self.u = None  # utilizador com sessão iniciada

    def iniciar(self, con, username, password):
        r = con.execute("SELECT * FROM utilizadores WHERE username=?", (username,)).fetchone()
        if not r or not verificar(password, r["password_hash"], r["salt"]):
            raise ErroUtilizador("Username ou palavra-passe incorretos.")
        self.u = dict(r)

    def terminar(self):
        self.u = None

    def _exigir(self):
        if not self.u:
            raise ErroUtilizador("É necessário iniciar sessão.")

    def alterar_dados(self, con, username=None, email=None):
        self._exigir()
        username, email = username or self.u["username"], email or self.u["email"]
        validar(username, email)
        _executar(con, "UPDATE utilizadores SET username=?, email=? WHERE id=?",
                  (username, email, self.u["id"]))
        self.u.update(username=username, email=email)

    def alterar_password(self, con, atual, nova):
        self._exigir()
        if not verificar(atual, self.u["password_hash"], self.u["salt"]):
            raise ErroUtilizador("Palavra-passe atual incorreta.")
        validar(password=nova)
        h, salt = gerar_hash(nova)
        _executar(con, "UPDATE utilizadores SET password_hash=?, salt=? WHERE id=?",
                  (h, salt, self.u["id"]))
        self.u.update(password_hash=h, salt=salt)

    def e_admin(self):
        return bool(self.u) and self.u["tipo"] == "Administrador"